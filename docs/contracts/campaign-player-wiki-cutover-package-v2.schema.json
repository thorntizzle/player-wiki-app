{
  "$id": "https://campaign-player-wiki.invalid/contracts/campaign-player-wiki-cutover-package-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Conformance requires this Draft 2020-12 structural and path validation plus the exporter runtime relational self-verification. Core JSON Schema uniqueItems detects duplicate whole objects only; runtime verification additionally enforces unique artifact paths, unique campaign slugs and stable IDs, and the campaign descriptor-to-mapping bijection.",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": { "$ref": "#/$defs/artifact" },
      "type": "array",
      "uniqueItems": true
    },
    "campaign_stable_ids": {
      "additionalProperties": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
        "type": "string"
      },
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
      },
      "type": "object"
    },
    "campaigns": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "campaign_slug": { "$ref": "#/$defs/stableId" },
          "campaign_stable_id": { "$ref": "#/$defs/stableId" },
          "content_sha256": { "$ref": "#/$defs/sha256" },
          "file_count": { "minimum": 0, "type": "integer" }
        },
        "required": [
          "campaign_slug",
          "campaign_stable_id",
          "content_sha256",
          "file_count"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "certification": {
      "additionalProperties": false,
      "properties": {
        "format_version": { "const": 2 },
        "manifest_hashes_verified": { "const": true },
        "verification_level": { "const": "verified_v2" }
      },
      "required": [
        "format_version",
        "manifest_hashes_verified",
        "verification_level"
      ],
      "type": "object"
    },
    "content_root_digest": { "$ref": "#/$defs/sha256" },
    "derivation_version": { "const": 1 },
    "disposition_totals": {
      "additionalProperties": false,
      "properties": {
        "intentionally_deferred": { "minimum": 0, "type": "integer" },
        "sealed_preservation": { "minimum": 0, "type": "integer" },
        "typed_projection": { "minimum": 0, "type": "integer" },
        "unsupported_quarantined": { "minimum": 0, "type": "integer" },
        "verified_source_zero": { "minimum": 0, "type": "integer" }
      },
      "required": [
        "intentionally_deferred",
        "sealed_preservation",
        "typed_projection",
        "unsupported_quarantined",
        "verified_source_zero"
      ],
      "type": "object"
    },
    "exporter": {
      "additionalProperties": false,
      "properties": {
        "commit": { "$ref": "#/$defs/gitIdentity" },
        "tree": { "$ref": "#/$defs/gitIdentity" }
      },
      "required": ["commit", "tree"],
      "type": "object"
    },
    "families": {
      "items": false,
      "prefixItems": [
        { "$ref": "#/$defs/accountsFamily" },
        { "$ref": "#/$defs/charactersFamily" },
        { "$ref": "#/$defs/systemsSourcesFamily" },
        { "$ref": "#/$defs/systemsContentFamily" },
        { "$ref": "#/$defs/campaignPagesFamily" },
        { "$ref": "#/$defs/sessionHistoryFamily" },
        { "$ref": "#/$defs/activeRuntimeFamily" },
        { "$ref": "#/$defs/assetsFamily" },
        { "$ref": "#/$defs/campaignSystemPoliciesFamily" },
        { "$ref": "#/$defs/campaignEnabledSourcesFamily" },
        { "$ref": "#/$defs/campaignEntryOverridesFamily" }
      ],
      "maxItems": 11,
      "minItems": 11,
      "type": "array"
    },
    "format": { "const": "campaign-player-wiki-cutover-package" },
    "format_version": { "const": 2 },
    "schema_digest": { "$ref": "#/$defs/sha256" },
    "schema_version": { "const": 1 },
    "snapshot": {
      "additionalProperties": false,
      "properties": {
        "byte_count": { "minimum": 1, "type": "integer" },
        "path": { "const": "source/database.sqlite3" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["byte_count", "path", "sha256"],
      "type": "object"
    },
    "source_stable_id": { "$ref": "#/$defs/stableId" }
  },
  "required": [
    "artifacts",
    "campaign_stable_ids",
    "campaigns",
    "certification",
    "content_root_digest",
    "derivation_version",
    "disposition_totals",
    "exporter",
    "families",
    "format",
    "format_version",
    "schema_digest",
    "schema_version",
    "snapshot",
    "source_stable_id"
  ],
  "title": "Campaign Player Wiki Cutover Package v2 Manifest",
  "type": "object",
  "$defs": {
    "family": {
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "path": { "$ref": "#/$defs/relativePath" },
        "record_count": { "minimum": 0, "type": "integer" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["name", "path", "record_count", "sha256"],
      "type": "object"
    },
    "accountsFamily": { "$ref": "#/$defs/family", "properties": { "name": { "const": "accounts" }, "path": { "const": "families/accounts.json" } } },
    "charactersFamily": { "$ref": "#/$defs/family", "properties": { "name": { "const": "characters" }, "path": { "const": "families/characters.json" } } },
    "systemsSourcesFamily": { "$ref": "#/$defs/family", "properties": { "name": { "const": "systems_sources" }, "path": { "const": "families/systems_sources.json" } } },
    "systemsContentFamily": { "$ref": "#/$defs/family", "properties": { "name": { "const": "systems_content" }, "path": { "const": "families/systems_content.json" } } },
    "campaignPagesFamily": { "$ref": "#/$defs/family", "properties": { "name": { "const": "campaign_pages" }, "path": { "const": "families/campaign_pages.json" } } },
    "sessionHistoryFamily": { "$ref": "#/$defs/family", "properties": { "name": { "const": "session_history" }, "path": { "const": "families/session_history.json" } } },
    "activeRuntimeFamily": { "$ref": "#/$defs/family", "properties": { "name": { "const": "active_runtime" }, "path": { "const": "families/active_runtime.json" } } },
    "assetsFamily": { "$ref": "#/$defs/family", "properties": { "name": { "const": "assets" }, "path": { "const": "families/assets.json" } } },
    "campaignSystemPoliciesFamily": { "$ref": "#/$defs/family", "properties": { "name": { "const": "campaign_system_policies" }, "path": { "const": "families/campaign_system_policies.json" } } },
    "campaignEnabledSourcesFamily": { "$ref": "#/$defs/family", "properties": { "name": { "const": "campaign_enabled_sources" }, "path": { "const": "families/campaign_enabled_sources.json" } } },
    "campaignEntryOverridesFamily": { "$ref": "#/$defs/family", "properties": { "name": { "const": "campaign_entry_overrides" }, "path": { "const": "families/campaign_entry_overrides.json" } } },
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "byte_count": { "minimum": 0, "type": "integer" },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["byte_count", "path", "sha256"],
      "type": "object"
    },
    "gitIdentity": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "relativePath": {
      "allOf": [
        { "not": { "pattern": "\\u0000" } },
        { "not": { "pattern": "%" } },
        { "not": { "pattern": "^(?:/|[A-Za-z]:|\\\\)" } },
        { "not": { "pattern": "\\\\" } },
        { "not": { "pattern": "(?:^|/)(?:\\.|\\.\\.)(?:/|$)" } },
        { "not": { "pattern": "//" } }
      ],
      "minLength": 1,
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "stableId": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "type": "string"
    }
  }
}
