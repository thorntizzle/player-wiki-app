{
  "$id": "https://campaign-player-wiki.invalid/contracts/campaign-player-wiki-cutover-package-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": { "$ref": "#/$defs/artifact" },
      "type": "array"
    },
    "campaign_stable_ids": {
      "additionalProperties": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
        "type": "string"
      },
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
      },
      "type": "object"
    },
    "campaigns": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "campaign_slug": { "$ref": "#/$defs/stableId" },
          "campaign_stable_id": { "$ref": "#/$defs/stableId" },
          "content_sha256": { "$ref": "#/$defs/sha256" },
          "file_count": { "minimum": 0, "type": "integer" }
        },
        "required": [
          "campaign_slug",
          "campaign_stable_id",
          "content_sha256",
          "file_count"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "certification": {
      "additionalProperties": false,
      "properties": {
        "format_version": { "const": 2 },
        "manifest_hashes_verified": { "const": true },
        "verification_level": { "const": "verified_v2" }
      },
      "required": [
        "format_version",
        "manifest_hashes_verified",
        "verification_level"
      ],
      "type": "object"
    },
    "content_root_digest": { "$ref": "#/$defs/sha256" },
    "derivation_version": { "const": 1 },
    "disposition_totals": {
      "additionalProperties": false,
      "properties": {
        "intentionally_deferred": { "minimum": 0, "type": "integer" },
        "sealed_preservation": { "minimum": 0, "type": "integer" },
        "typed_projection": { "minimum": 0, "type": "integer" },
        "unsupported_quarantined": { "minimum": 0, "type": "integer" },
        "verified_source_zero": { "minimum": 0, "type": "integer" }
      },
      "required": [
        "intentionally_deferred",
        "sealed_preservation",
        "typed_projection",
        "unsupported_quarantined",
        "verified_source_zero"
      ],
      "type": "object"
    },
    "exporter": {
      "additionalProperties": false,
      "properties": {
        "commit": { "$ref": "#/$defs/gitIdentity" },
        "tree": { "$ref": "#/$defs/gitIdentity" }
      },
      "required": ["commit", "tree"],
      "type": "object"
    },
    "families": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "accounts",
              "characters",
              "systems_sources",
              "systems_content",
              "campaign_pages",
              "session_history",
              "active_runtime",
              "assets",
              "campaign_system_policies",
              "campaign_enabled_sources",
              "campaign_entry_overrides"
            ]
          },
          "path": { "$ref": "#/$defs/relativePath" },
          "record_count": { "minimum": 0, "type": "integer" },
          "sha256": { "$ref": "#/$defs/sha256" }
        },
        "required": ["name", "path", "record_count", "sha256"],
        "type": "object"
      },
      "maxItems": 11,
      "minItems": 11,
      "type": "array",
      "uniqueItems": true
    },
    "format": { "const": "campaign-player-wiki-cutover-package" },
    "format_version": { "const": 2 },
    "schema_digest": { "$ref": "#/$defs/sha256" },
    "schema_version": { "const": 1 },
    "snapshot": {
      "additionalProperties": false,
      "properties": {
        "byte_count": { "minimum": 1, "type": "integer" },
        "path": { "const": "source/database.sqlite3" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["byte_count", "path", "sha256"],
      "type": "object"
    },
    "source_stable_id": { "$ref": "#/$defs/stableId" }
  },
  "required": [
    "artifacts",
    "campaign_stable_ids",
    "campaigns",
    "certification",
    "content_root_digest",
    "derivation_version",
    "disposition_totals",
    "exporter",
    "families",
    "format",
    "format_version",
    "schema_digest",
    "schema_version",
    "snapshot",
    "source_stable_id"
  ],
  "title": "Campaign Player Wiki Cutover Package v2 Manifest",
  "type": "object",
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "byte_count": { "minimum": 0, "type": "integer" },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["byte_count", "path", "sha256"],
      "type": "object"
    },
    "gitIdentity": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "relativePath": {
      "allOf": [
        { "not": { "pattern": "^(?:/|[A-Za-z]:|\\\\)" } },
        { "not": { "pattern": "(?:^|/)\\.\\.(?:/|$)" } }
      ],
      "minLength": 1,
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "stableId": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "type": "string"
    }
  }
}
